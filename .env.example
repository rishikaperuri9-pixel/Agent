# Target website to crawl and index
TARGET_WEBSITE=https://fastapi.tiangolo.com/

# Groq API Key (Required for LLM inference - llama-3.3-70b-versatile)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Embedding Provider: 'huggingface' (Default, free local CPU, no key needed) or 'openai'
EMBEDDING_PROVIDER=huggingface

# Groq Model: 'llama-3.1-8b-instant', 'llama-3.3-70b-versatile', or 'llama3-70b-8192'
GROQ_MODEL=llama-3.1-8b-instant


# Optional: OpenAI API Key (Only needed if EMBEDDING_PROVIDER=openai)
# OPENAI_API_KEY=sk-your_openai_api_key_here